{
  "name": "datatrust-connector-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names gateway,web --prefix-colors cyan,green \"npm:dev:gateway\" \"npm:dev:web\"",
    "dev:gateway": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "start:gateway": "tsx server/index.ts",
    "start": "npm run start:gateway",
    "native:build": "bash scripts/build-native-linux.sh",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test server/handshake-parser.test.ts server/handshake-runner.test.ts server/runtime-config.test.ts server/ssh-transport.test.ts",
    "check": "npm run test && npm run build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "swr": "2.5.1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "9.2.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.1.3"
  }
}
