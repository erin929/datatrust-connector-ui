# Connector Gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# Existing openHiTLS demo client. Build unified_tls_client on the target system,
# then use its absolute path here.
HITLS_CLIENT_BIN=/absolute/path/to/unified_tls_client
HITLS_CLIENT_WORKDIR=/absolute/path/to/openhitls-main/testcode/demo-did

# Optional arguments placed before the openHiTLS arguments. This must be a JSON
# array and is mainly useful when the executable is a wrapper.
HITLS_CLIENT_PREFIX_ARGS=[]

# The current unified client has a compile-time target. These values are shown
# by the UI and must match the binary that was built.
HITLS_FIXED_HOST=127.0.0.1
HITLS_FIXED_PORT=12346

# Required only when mTLS is enabled in authMode=did or authMode=auto.
# Single-sided DID mode verifies the server DID without these client files.
HITLS_DID_CERT=/absolute/path/to/client.did.der
HITLS_DID_KEY=/absolute/path/to/client.did.key.der
