# 控制电脑上的 Web + Gateway。0.0.0.0 允许同一受信任局域网中的电脑访问。
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8787
# 最新双板卡方案使用 SSH；浏览器不会接触 SSH 私钥或远程命令。
HITLS_TRANSPORT=ssh
HITLS_SSH_BIN=C:\Windows\System32\OpenSSH\ssh.exe
HITLS_SSH_CONNECT_TIMEOUT_MS=5000
HITLS_SSH_STRICT_HOST_KEY_CHECKING=yes
# 可留空并使用当前 Windows 用户的默认 known_hosts。
HITLS_SSH_KNOWN_HOSTS=
# 板卡21：openHiTLS 服务端。
HITLS_SERVER_SSH_HOST=192.168.50.21
HITLS_SERVER_SSH_PORT=22
HITLS_SERVER_SSH_USER=root
# 可留空并使用 ssh-agent；如果填写，必须是控制电脑上的私钥绝对路径。
HITLS_SERVER_SSH_IDENTITY=
HITLS_SERVER_WORKDIR=/root/openhitls-main/testcode/demo-did/build
HITLS_SERVER_BIN=./tls_server
HITLS_SERVER_DID_CERT=./certs/server_indy_cert.der
HITLS_SERVER_DID_KEY=./certs/server_indy_key.der
HITLS_SERVER_FAKE_DID_CERT=./certs/fake_server_indy_cert.der
HITLS_SERVER_FAKE_DID_KEY=./certs/fake_server_indy_key.der
HITLS_SERVER_UNKNOWN_DID_CERT=./certs/unknown_server_cert.der
HITLS_SERVER_UNKNOWN_DID_KEY=./certs/unknown_server_key.der
HITLS_SERVER_STARTUP_TIMEOUT_MS=8000
# 板卡22：openHiTLS 客户端。
HITLS_CLIENT_SSH_HOST=192.168.50.22
HITLS_CLIENT_SSH_PORT=22
HITLS_CLIENT_SSH_USER=root
HITLS_CLIENT_SSH_IDENTITY=
HITLS_CLIENT_WORKDIR=/root/openhitls-main/testcode/demo-did/build
HITLS_CLIENT_BIN=./tls_client
HITLS_DID_CERT=../client_did_cert.der
HITLS_DID_KEY=../client_did_key.der
# 两块板卡上的 openHiTLS / indy-vdr 动态库目录。
HITLS_REMOTE_LIBRARY_PATH=/root/openhitls-main/build:/root/indy-vdr/target/release
# 最新客户端与服务端二进制实际使用 192.168.50.21:12345。
# 这里用于就绪检测和页面展示，必须与板卡上的实际二进制完全一致。
HITLS_TLS_TARGET=192.168.50.21
HITLS_TLS_PORT=12345
# Indy genesis 当前定义的验证节点位于 192.168.50.100。
HITLS_INDY_HOST=192.168.50.100
HITLS_INDY_PORT=9702
HITLS_REMOTE_GENESIS_PATH=/root/openhitls-main/testcode/demo-did/pool_transactions_genesis

# Fabric 审计是可选的真实外部能力。只有配置身份文件后才设为 true。
FABRIC_AUDIT_ENABLED=false
FABRIC_PEER_ENDPOINT=192.168.50.21:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.datatrust.local
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=datatrustchannel
FABRIC_CHAINCODE=datatrust-audit
# 以下三项填控制电脑上的绝对路径；证书和私钥不得提交到 Git。
FABRIC_TLS_ROOT_CERT=
FABRIC_IDENTITY_CERT=
FABRIC_IDENTITY_KEY=
