# 旧 unified_tls_client / unified_tls_server 的本机兼容模式。
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
HITLS_TRANSPORT=local

HITLS_CLIENT_BIN=/absolute/path/to/unified_tls_client
HITLS_CLIENT_WORKDIR=/absolute/path/to/openhitls-main/testcode/demo-did
HITLS_CLIENT_PREFIX_ARGS=[]
HITLS_FIXED_HOST=127.0.0.1
HITLS_FIXED_PORT=12346

HITLS_MANAGE_SERVER=true
HITLS_SERVER_BIN=/absolute/path/to/unified_tls_server
HITLS_SERVER_WORKDIR=/absolute/path/to/openhitls-main/testcode/demo-did
HITLS_SERVER_STARTUP_TIMEOUT_MS=3000

HITLS_DID_CERT=/absolute/path/to/client.did.der
HITLS_DID_KEY=/absolute/path/to/client.did.key.der
HITLS_SERVER_DID_CERT=/absolute/path/to/server_did_cert.der
HITLS_SERVER_DID_KEY=/absolute/path/to/server_did_key.der
INDY_GENESIS_PATH=/absolute/path/to/pool_transactions_genesis
